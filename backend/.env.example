# Copy to backend/.env:  cp .env.example .env
DEBUG=true
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789abcdef
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# Generate with: make hatchet-token  (see README)
HATCHET_CLIENT_TOKEN=
# hatchet-lite runs without TLS locally
HATCHET_CLIENT_TLS_STRATEGY=none

# Encrypts secrets at rest (LLM API keys). Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
