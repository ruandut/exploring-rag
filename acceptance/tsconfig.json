{
  // Type-check only (`vp run typecheck`). Node runs the .ts files directly via type stripping,
  // so only erasable TypeScript syntax is allowed.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["support", "steps", "pages"]
}
