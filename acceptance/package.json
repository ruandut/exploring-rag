{
  "name": "rag-acceptance",
  "private": true,
  "type": "module",
  "description": "Executable specs: runs the Gherkin scenarios in specs/*.md against the running app",
  "scripts": {
    "test": "cucumber-js",
    "typecheck": "tsc -p ."
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "ws": "^8.22.0"
  }
}
